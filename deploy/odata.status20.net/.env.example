# Kopie als .env anlegen und alle Werte setzen. Zufallswerte z. B. mit: openssl rand -base64 24
JDBCODATA_VERSION=1.1.0
JDBCODATA_ADMIN_USER=admin
JDBCODATA_ADMIN_PASSWORD=
# 32 Bytes Base64: openssl rand -base64 32
JDBCODATA_MASTER_KEY=
# Metadaten-DB (Container meta-db)
META_DB_PASSWORD=
# Demo-DB (Container demo-db): Superuser und die Lese-User, mit denen sich Excel anmeldet (Pass-Through)
DEMO_ADMIN_PASSWORD=
DEMO_READER_PASSWORD=
DEMO_NORD_PASSWORD=
DEMO_ANNA_PASSWORD=
DEMO_BERND_PASSWORD=
# Nutzungsstatistik für das Dashboard usage.status20.net; leer = aus. Hash-Secret: openssl rand -base64 32
JDBCODATA_USAGE_DB_URL=
JDBCODATA_USAGE_DB_USER=
JDBCODATA_USAGE_DB_PASSWORD=
JDBCODATA_USAGE_HASH_SECRET=
