{
  "realm": "jdbcodata",
  "enabled": true,
  "sslRequired": "none",
  "groups": [{"name": "jdbcodata-admins"}, {"name": "jdbcodata-viewers"}],
  "clients": [{
    "clientId": "jdbcodata",
    "secret": "test-client-secret",
    "enabled": true,
    "publicClient": false,
    "standardFlowEnabled": true,
    "redirectUris": ["*"],
    "attributes": {"post.logout.redirect.uris": "+"},
    "protocolMappers": [{
      "name": "groups",
      "protocol": "openid-connect",
      "protocolMapper": "oidc-group-membership-mapper",
      "config": {"claim.name": "groups", "full.path": "false", "id.token.claim": "true", "userinfo.token.claim": "true"}
    }]
  }],
  "users": [
    {"username": "anna", "enabled": true, "email": "anna@example.org", "emailVerified": true, "firstName": "Anna", "lastName": "Admin",
     "credentials": [{"type": "password", "value": "anna-pw"}], "groups": ["jdbcodata-admins"]},
    {"username": "vera", "enabled": true, "email": "vera@example.org", "emailVerified": true, "firstName": "Vera", "lastName": "Viewer",
     "credentials": [{"type": "password", "value": "vera-pw"}], "groups": ["jdbcodata-viewers"]},
    {"username": "nora", "enabled": true, "email": "nora@example.org", "emailVerified": true, "firstName": "Nora", "lastName": "Nobody",
     "credentials": [{"type": "password", "value": "nora-pw"}]}
  ]
}
