# Host name clients use (TLS certificate is issued for it). "localhost" = self-signed internal CA.
JDBCODATA_HOST=localhost
# "internal" (self-signed), an e-mail address (Let's Encrypt, public host) or "/certs/cert.pem /certs/key.pem"
JDBCODATA_TLS=internal
JDBCODATA_VERSION=1.0.0
# host ports of the Caddy proxy
JDBCODATA_HTTP_PORT=80
JDBCODATA_HTTPS_PORT=443

JDBCODATA_ADMIN_USER=admin
JDBCODATA_ADMIN_PASSWORD=change-me-now
# 32 random bytes, Base64: openssl rand -base64 32
JDBCODATA_MASTER_KEY=

POSTGRES_DB=jdbcodata
POSTGRES_USER=jdbcodata
POSTGRES_PASSWORD=change-me-too

# Optional settings (seed file, limits, ...) go into ./config/application.yml, e.g.
#   jdbcodata:
#     seed:
#       file: /app/config/seed.yml
