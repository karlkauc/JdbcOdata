# systemd unit for JdbcOdata. Install: copy to /etc/systemd/system/, adjust paths and user,
# then: systemctl daemon-reload && systemctl enable --now jdbcodata
[Unit]
Description=JdbcOdata - OData feeds for company databases
After=network.target

[Service]
Type=simple
User=jdbcodata
Group=jdbcodata
WorkingDirectory=/opt/jdbcodata
EnvironmentFile=-/etc/jdbcodata/jdbcodata.env
ExecStart=/opt/jdbcodata/bin/jdbcodata.sh
Restart=on-failure
RestartSec=5
# hardening; UMask keeps data/master.key, the H2 files and logs private to the service account
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
ReadWritePaths=/opt/jdbcodata/data /opt/jdbcodata/logs

[Install]
WantedBy=multi-user.target
