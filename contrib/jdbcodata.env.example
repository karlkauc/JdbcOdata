# /etc/jdbcodata/jdbcodata.env - environment for the systemd unit (chmod 600)
JDBCODATA_ADMIN_USER=admin
# empty: a random password is written to data/initial-admin-password (mode 600)
JDBCODATA_ADMIN_PASSWORD=
JDBCODATA_MASTER_KEY=
# TLS with a PKCS12 keystore in certs/ (see docs/OPERATIONS.md); alternatively a reverse proxy and
# JDBCODATA_SECURITY_ALLOW_PLAIN_HTTP=true
SERVER_SSL_KEY_STORE=certs/jdbcodata.p12
SERVER_SSL_KEY_STORE_PASSWORD=
SERVER_SSL_KEY_STORE_TYPE=PKCS12
SERVER_PORT=8443
